# === Platform default SmartSuite (used as fallback for org #1 only) ===
SMARTSUITE_API_KEY=your_api_key_here
SMARTSUITE_ACCOUNT_ID=your_account_id_here
SOURCE_CUSTOMERS_TABLE_ID=65fa17c1c4bf7d283e83807a
DESTINATION_INTELLIGENCE_HUB_TABLE_ID=6972e0912eaf730900141a54
SOLUTION_ID=6972e0912eaf730900141a53

# === Import / job defaults ===
IMPORT_BATCH_SIZE=25
DRY_RUN=false
LOG_LEVEL=INFO

# === App ===
APP_BASE_URL=http://localhost:3000
NODE_ENV=development
PORT=3001
PYTHON_BIN=python3
SESSION_SECRET=change_me_in_production
# 32+ random bytes; used by AES-256-GCM for encrypting per-org integration secrets
APP_ENCRYPTION_KEY=change_me_to_random_32_bytes_minimum

# === Seed/admin (one-time, for first boot of org #1) ===
ADMIN_EMAIL=info@civenterprises.com
ADMIN_PASSWORD=Ciara@CIV

# === Stripe ===
# Leave empty to disable billing; the app boots fine without these.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=
STRIPE_PRICE_CREDITS_SMALL=
STRIPE_PRICE_CREDITS_MEDIUM=
STRIPE_PRICE_CREDITS_LARGE=

# === Resend (Phase 6) ===
# Platform-managed email sender for paid plans. Free plan must BYO.
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@prospectforge.app
RESEND_FROM_NAME=Prospect Forge
RESEND_WEBHOOK_SECRET=

# === Twilio (Phase 6) ===
# Platform-managed SMS sender for paid plans. Free plan must BYO.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# === Outreach scheduler ===
# Set to "true" to enable the every-minute campaign send tick.
OUTREACH_SCHEDULER_ENABLED=false
